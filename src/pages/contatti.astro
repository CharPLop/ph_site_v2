---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Icona from "@/components/Icona.astro";
import { site, sedi, team } from "@/config/site";
const brescia = sedi.find((s) => s.mappaEmbed);
---

<BaseLayout
  title="Contatti"
  description="Contatta lo studio Psiche Holos a Brescia, Via Guido Zadei 60: WhatsApp, email, telefono delle professioniste. Su appuntamento, anche online."
  path="/contatti/"
>
  <!-- Contatti per professionista: si sceglie la persona, non il canale -->
  <section class="container-ph pt-16 md:pt-24">
    <p class="kicker">Prendi appuntamento</p>
    <h1 class="mt-3 text-[clamp(2.4rem,5vw,3.6rem)]">Il primo passo? Contattaci.</h1>
    <p class="mt-5 max-w-2xl text-lg text-[var(--color-ink-soft)]">
      Non serve aver chiaro cosa dire. Puoi scrivere direttamente alla
      professionista che preferisci.
    </p>

    <ul id="professioniste" class="mt-10 grid gap-5 md:grid-cols-3">
      {team.map((m) => (
        <li class="flex flex-col items-center rounded-[var(--radius-md)] border border-[var(--color-line)] bg-[var(--color-white-warm)] p-6 text-center">
          {m.foto && (
            <img src={m.avatar ?? m.foto} alt="" width="80" height="80" loading="lazy" class="h-20 w-20 rounded-full object-cover object-center" />
          )}
          <h2 class="mt-4 text-xl">{m.nome}</h2>
          <p class="mt-1 text-sm text-[var(--color-ink-soft)]">{m.ambitoBreve}</p>
          <div class="mt-5 flex flex-wrap justify-center gap-2 text-sm font-semibold">
            <a href={m.whatsapp} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-line)] px-4 py-2 text-[var(--color-verde-dark)] transition-colors hover:border-[var(--color-verde)]">
              <Icona nome="whatsapp" />WhatsApp
            </a>
            <a href={`tel:+39${m.telefonoDisplay.replace(/\s/g, "")}`} class="inline-flex items-center gap-1.5 rounded-full border border-[var(--color-line)] px-4 py-2 text-[var(--color-verde-dark)] transition-colors hover:border-[var(--color-verde)]">
              <Icona nome="telefono" />{m.telefonoDisplay}
            </a>
          </div>
        </li>
      ))}
    </ul>

    <div class="mt-6 flex items-start gap-3 rounded-[var(--radius-md)] bg-[var(--color-cream-deep)] p-5 text-[var(--color-ink-soft)]">
      <span class="mt-0.5 text-[var(--color-verde-dark)]"><Icona nome="email" size={20} /></span>
      <p>
        <strong class="text-[var(--color-ink)]">Non sai a chi rivolgerti?</strong>
        Scrivici a <a href={`mailto:${site.email}`} class="link-underline font-semibold text-[var(--color-verde-dark)]">{site.email}</a>
        o compila il <a href="#modulo" class="link-underline font-semibold text-[var(--color-verde-dark)]">modulo qui sotto</a>:
        ti indirizziamo noi alla professionista più adatta.
      </p>
    </div>
  </section>

  <!-- Dove siamo -->
  <section class="container-ph mt-16 grid gap-8 md:grid-cols-2">
    <div>
      <h2 class="text-2xl">Dove siamo</h2>
      <div class="mt-5 rounded-[var(--radius-md)] border border-[var(--color-line)] bg-[var(--color-white-warm)] p-5">
        <p class="font-semibold text-[var(--color-verde)]">Studio Psiche Holos</p>
        <p class="text-sm text-[var(--color-ink-soft)]">Via Guido Zadei, 60 — Brescia (BS)</p>
        <p class="mt-1 text-sm text-[var(--color-ink-soft)]">Su appuntamento · anche online</p>
        <p class="mt-1 text-sm text-[var(--color-ink-soft)]">Parcheggio disponibile nelle vicinanze</p>
      </div>
      <p class="mt-6 text-sm text-[var(--color-ink-soft)]">
        Hai dubbi prima di scriverci? Leggi le
        <a href="/faq/" class="link-underline font-semibold text-[var(--color-verde)]">domande frequenti</a>
        o seguici su <a href={site.instagram} target="_blank" rel="noopener" class="link-underline font-semibold text-[var(--color-verde)]">Instagram</a>.
      </p>
    </div>
    {brescia?.mappaEmbed && (
      <div class="overflow-hidden rounded-[var(--radius-md)] border border-[var(--color-line)] md:mt-12">
        <iframe
          src={brescia.mappaEmbed}
          title="Mappa — Studio Psiche Holos, Brescia"
          height="300"
          class="block w-full"
          style="border:0"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    )}
  </section>

  <!-- FORM CONTATTI — senza site.web3formsKey resta visibile, ma l'invio mostra
       subito il box con i canali alternativi (attributo segnalato dal guard di build) -->
  <section id="modulo" class="container-ph mt-16 mb-4 scroll-mt-24 md:mt-20">
    <div class="rounded-[var(--radius-lg)] border border-[var(--color-line)] bg-[var(--color-white-warm)] p-7 md:p-9">
      <p class="kicker">Oppure scrivici direttamente</p>
      <h2 class="mt-3 text-[clamp(1.5rem,3vw,2rem)]">Lasciaci il tuo numero, ti ricontattiamo noi</h2>

      <form id="contactForm" action="https://api.web3forms.com/submit" method="POST" class="mt-6 space-y-4" data-senza-key={site.web3formsKey ? undefined : "true"}>
        <input type="hidden" name="access_key" value={site.web3formsKey}>
        <input type="hidden" name="subject" value="Nuovo contatto dal sito Psiche Holos" data-oggetto-base="Nuovo contatto dal sito Psiche Holos">
        <input type="hidden" name="from_name" value="Sito Psiche Holos">
        <input type="checkbox" name="botcheck" class="hidden" tabindex="-1">

        <div class="grid gap-4 sm:grid-cols-2">
          <div>
            <label class="block text-sm font-medium text-[var(--color-ink-soft)]" for="cf-nome">Nome *</label>
            <input id="cf-nome" type="text" name="name" autocomplete="name" required placeholder="Il tuo nome"
              class="mt-1.5 w-full rounded-[10px] border border-[var(--color-line)] bg-white px-4 py-2.5 text-[var(--color-ink)] outline-none transition focus:border-[var(--color-verde)] focus:ring-2 focus:ring-[var(--color-sage)]">
          </div>
          <div>
            <label class="block text-sm font-medium text-[var(--color-ink-soft)]" for="cf-tel">Telefono *</label>
            <input id="cf-tel" type="tel" name="phone" autocomplete="tel" required placeholder="Es: 333 1234567" pattern="[0-9\s\+]{6,20}" title="Inserisci un numero di telefono valido"
              class="mt-1.5 w-full rounded-[10px] border border-[var(--color-line)] bg-white px-4 py-2.5 text-[var(--color-ink)] outline-none transition focus:border-[var(--color-verde)] focus:ring-2 focus:ring-[var(--color-sage)]">
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-[var(--color-ink-soft)]" for="cf-email">Email <span class="font-normal">(opzionale)</span></label>
          <input id="cf-email" type="email" name="email" autocomplete="email" placeholder="La tua email"
            class="mt-1.5 w-full rounded-[10px] border border-[var(--color-line)] bg-white px-4 py-2.5 text-[var(--color-ink)] outline-none transition focus:border-[var(--color-verde)] focus:ring-2 focus:ring-[var(--color-sage)]">
        </div>

        <div>
          <label class="block text-sm font-medium text-[var(--color-ink-soft)]" for="cf-per">A chi vuoi scrivere?</label>
          <select id="cf-per" name="destinataria"
            class="mt-1.5 w-full rounded-[10px] border border-[var(--color-line)] bg-white px-4 py-2.5 text-[var(--color-ink)] outline-none transition focus:border-[var(--color-verde)] focus:ring-2 focus:ring-[var(--color-sage)]">
            <option value="Non so, indirizzatemi voi">Non so, indirizzatemi voi</option>
            {team.map((m) => <option value={m.nome}>{m.nome}</option>)}
          </select>
        </div>

        <div>
          <label class="block text-sm font-medium text-[var(--color-ink-soft)]" for="cf-msg">Come possiamo aiutarti? <span class="font-normal">(opzionale)</span></label>
          <textarea id="cf-msg" name="message" rows="4" placeholder="Non serve scrivere molto — anche solo 'vorrei informazioni' va benissimo"
            class="mt-1.5 w-full rounded-[10px] border border-[var(--color-line)] bg-white px-4 py-2.5 text-[var(--color-ink)] outline-none transition focus:border-[var(--color-verde)] focus:ring-2 focus:ring-[var(--color-sage)]" aria-describedby="cf-msg-nota"></textarea>
          <p id="cf-msg-nota" class="mt-2 flex items-start gap-2 rounded-[var(--radius-sm)] bg-[var(--color-cream-deep)] px-3 py-2 text-sm text-[var(--color-ink-soft)]">
            Non serve descrivere la tua situazione qui: ne parliamo a voce, in modo riservato.
          </p>
        </div>

        <button type="submit" class="btn btn-primary">Invia richiesta</button>
        <p class="text-sm text-[var(--color-ink-soft)]">
          Useremo i tuoi dati solo per ricontattarti.
          <a href="/privacy/" class="link-underline font-semibold text-[var(--color-verde-dark)]">Informativa privacy</a>
        </p>

        <div id="formError" role="alert" tabindex="-1" class="hidden rounded-[var(--radius-md)] border border-[#d9a3a0] bg-[#fbeceb] px-5 py-4 text-[#7a2320]">
          <strong>Il messaggio non è partito.</strong> Riprova tra poco, oppure scrivi direttamente a una
          <a href="#professioniste" class="underline">delle professioniste</a> su WhatsApp o manda una
          <a href={`mailto:${site.email}`} class="underline">email</a>.
        </div>
      </form>

      <div id="formSuccess" role="status" tabindex="-1" class="mt-4 hidden rounded-[var(--radius-md)] bg-[var(--color-sage)] px-5 py-4 text-[var(--color-verde)]">
        <strong>Messaggio inviato.</strong> Ti ricontatteremo al numero che hai indicato.
      </div>
    </div>
  </section>

  <script>
    const phForm = document.getElementById('contactForm');
    // L'oggetto dell'email riporta a chi è rivolta la richiesta
    const per = document.getElementById('cf-per');
    const oggetto = phForm?.querySelector('input[name="subject"]');
    if (per && oggetto) {
      per.addEventListener('change', () => {
        const base = oggetto.dataset.oggettoBase;
        oggetto.value = per.value.startsWith('Non so') ? base : `${base} — per ${per.value}`;
      });
    }
    if (phForm) {
      phForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const btn = phForm.querySelector('button[type="submit"]');
        const errBox = document.getElementById('formError');
        errBox?.classList.add('hidden');
        // Access key non ancora configurata: niente chiamata, solo canali alternativi
        if (phForm.dataset.senzaKey) {
          errBox?.classList.remove('hidden');
          errBox?.focus();
          return;
        }
        if (btn) { btn.disabled = true; btn.textContent = 'Invio in corso…'; }
        try {
          const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: new FormData(phForm) });
          const data = await res.json();
          if (data.success) {
            phForm.style.display = 'none';
            const ok = document.getElementById('formSuccess');
            ok?.classList.remove('hidden');
            ok?.focus();
          } else {
            throw new Error('fail');
          }
        } catch {
          errBox?.classList.remove('hidden');
          errBox?.focus();
          if (btn) { btn.disabled = false; btn.textContent = 'Invia richiesta'; }
        }
      });
    }
  </script>
</BaseLayout>
