---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

import { team } from "@/config/site";
import Foto from "@/components/Foto.astro";

// In sviluppo si vedono anche le bozze (con etichetta), nella build mai.
const posts = (await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.bozza)).sort(
  (a, b) => b.data.data.getTime() - a.data.data.getTime()
);

const fmtData = (d: Date): string =>
  new Intl.DateTimeFormat("it-IT", { day: "numeric", month: "long", year: "numeric" }).format(d);
---

<BaseLayout
  title="Blog"
  seoTitle="Blog di psicologia: articoli e approfondimenti | Psiche Holos"
  description="Approfondimenti e articoli a cura dello studio Psiche Holos su psicologia, benessere, mindfulness e crescita personale."
  path="/blog/"
>
  <section class="container-ph max-w-4xl pt-16 md:pt-24">
    <p class="kicker">Approfondimenti</p>
    <h1 class="mt-3 text-[clamp(2.4rem,5vw,3.6rem)]">Blog</h1>
    <p class="mt-4 max-w-2xl text-[var(--color-ink-soft)]">
      Spunti e riflessioni sul benessere psicologico, a cura delle professioniste dello studio.
    </p>

    {posts.length === 0 ? (
      <p class="mt-12 text-[var(--color-ink-soft)]">
        Non ci sono ancora articoli pubblicati. Torna presto!
      </p>
    ) : (
      <div class="mt-12 grid gap-8 sm:grid-cols-2">
        {posts.map((post) => (
          <a
            href={`/blog/${post.id}/`}
            class="group flex flex-col overflow-hidden rounded-[var(--radius-md)] border border-[var(--color-line)] bg-[var(--color-white-warm)] transition-colors hover:border-[var(--color-verde)]"
          >
            {post.data.copertina && (
              <div class="aspect-[16/10] overflow-hidden">
                <Foto
                  src={post.data.copertina}
                  alt={post.data.copertinaAlt ?? post.data.titolo}
                  class="h-full w-full object-cover"
                  width={1600}
                  height={1000}
                />
              </div>
            )}
            <div class="flex flex-1 flex-col p-6">
              <p class="text-xs font-bold uppercase tracking-wider text-[var(--color-verde-dark)]">
                {post.data.bozza && <span class="mr-2 rounded bg-[#fbe3e1] px-1.5 py-0.5 text-[#7a2320]">Bozza</span>}
                <time datetime={post.data.data.toISOString()}>{fmtData(post.data.data)}</time>
              </p>
              <h2 class="mt-2 font-[family-name:var(--font-display)] text-2xl text-[var(--color-ink)]">
                {post.data.titolo}
              </h2>
              <p class="mt-2 flex-1 text-[var(--color-ink-soft)]">{post.data.descrizione}</p>
              {post.data.autrice && (
                <p class="mt-3 text-sm text-[var(--color-ink-soft)]">
                  di {team.find((m) => m.slug === post.data.autrice)?.nome}
                </p>
              )}
              <span class="mt-4 font-semibold text-[var(--color-verde)]">Leggi l'articolo →</span>
            </div>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
