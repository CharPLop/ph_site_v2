---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";
import { site, team } from "@/config/site";
import Foto from "@/components/Foto.astro";

export async function getStaticPaths() {
  // In sviluppo si vedono anche le bozze, nella build mai.
  const posts = await getCollection("blog", ({ data }) => import.meta.env.DEV || !data.bozza);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const autrice = team.find((m) => m.slug === post.data.autrice);
const nomeAutore = autrice?.nome ?? post.data.autore;
const linkAutrice = autrice ? (autrice.sitoWeb ?? `/team/${autrice.slug}/`) : undefined;

const fmtData = (d: Date): string =>
  new Intl.DateTimeFormat("it-IT", { day: "numeric", month: "long", year: "numeric" }).format(d);

const articleLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.data.titolo,
  description: post.data.descrizione,
  datePublished: post.data.data.toISOString(),
  dateModified: (post.data.aggiornato ?? post.data.data).toISOString(),
  inLanguage: "it-IT",
  mainEntityOfPage: `${site.url}/blog/${post.id}/`,
  author: autrice
    ? {
        "@type": "Person",
        "@id": `${site.url}/team/#${autrice.slug}`,
        name: autrice.nome,
        jobTitle: autrice.ruolo,
        url: autrice.sitoWeb ?? `${site.url}/team/${autrice.slug}/`,
      }
    : { "@type": "Organization", name: post.data.autore },
  publisher: { "@type": "Organization", name: site.nome, url: site.url },
  ...(post.data.copertina
    ? { image: new URL(post.data.copertina, site.url).href }
    : {}),
};
---

<BaseLayout
  title={post.data.titolo}
  description={post.data.descrizione}
  path={`/blog/${post.id}/`}
  image={post.data.copertina}
  type="article"
>
  <article class="container-ph max-w-2xl pt-16 md:pt-24">
    <a href="/blog/" class="text-sm font-semibold text-[var(--color-verde)] link-underline">
      ← Tutti gli articoli
    </a>

    <p class="mt-8 text-xs font-bold uppercase tracking-wider text-[var(--color-verde-dark)]">
      {post.data.bozza && <span class="mr-2 rounded bg-[#fbe3e1] px-1.5 py-0.5 text-[#7a2320]">Bozza — non pubblicata</span>}
      <time datetime={post.data.data.toISOString()}>{fmtData(post.data.data)}</time>
      {post.data.aggiornato && (
        <> · aggiornato il <time datetime={post.data.aggiornato.toISOString()}>{fmtData(post.data.aggiornato)}</time></>
      )}
    </p>
    <h1 class="mt-2 text-[clamp(2rem,4.5vw,3.2rem)]">{post.data.titolo}</h1>
    {autrice ? (
      <a href={linkAutrice} target={autrice.sitoWeb ? "_blank" : undefined} rel={autrice.sitoWeb ? "noopener" : undefined} class="group mt-4 flex items-center gap-3">
        <img src={autrice.avatar ?? autrice.foto} alt="" width="44" height="44" class="h-11 w-11 rounded-full object-cover" />
        <span class="text-sm">
          <span class="block font-semibold text-[var(--color-ink)] group-hover:underline">{autrice.nome}</span>
          <span class="block text-[var(--color-ink-soft)]">{autrice.ruolo}</span>
        </span>
      </a>
    ) : (
      <p class="mt-3 text-sm text-[var(--color-ink-soft)]">di {nomeAutore}</p>
    )}

    {post.data.copertina && (
      <Foto
        src={post.data.copertina}
        alt={post.data.copertinaAlt ?? post.data.titolo}
        class="mt-8 aspect-[16/9] w-full rounded-[var(--radius-md)] object-cover"
        loading="eager"
        fetchpriority="high"
        width={1600}
        height={900}
      />
    )}

    <div class="prose-ph mt-10">
      <Content />
    </div>

    <aside class="mt-12 rounded-[var(--radius-md)] border border-[var(--color-line)] bg-[var(--color-cream-deep)] p-5 text-sm text-[var(--color-ink-soft)]">
      <strong class="text-[var(--color-ink)]">Nota.</strong> I contenuti di questo articolo hanno
      finalità informative ed educative e non sostituiscono una consulenza psicologica o un percorso
      personalizzato. Per una valutazione del tuo caso,
      <a href="/contatti/" class="link-underline text-[var(--color-verde)]">contattaci</a>.
    </aside>

    <div class="mt-10">
      <a href="/contatti/" class="btn btn-primary">Prenota un primo colloquio</a>
    </div>
  </article>

  <script type="application/ld+json" set:html={JSON.stringify(articleLd)} />
</BaseLayout>
