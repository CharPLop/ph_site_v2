---
import { existsSync } from "node:fs";
import nodePath from "node:path";
import { site } from "@/config/site";
import StudioSchema from "@/components/StudioSchema.astro";

interface Props {
  title: string;
  description?: string;
  /** path della pagina (es. "/studio/") per canonical/OG */
  path?: string;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
}

const {
  title,
  description = site.descrizione,
  path = Astro.url.pathname,
  image = "/foto/edit/og-card.jpg",
  type = "website",
  noindex = false,
} = Astro.props;

// title coerente: "Pagina | Psiche Holos" (la home passa già il title completo)
const fullTitle = title.includes(site.nome) ? title : `${title} | ${site.nome}`;

const canonical = new URL(path, Astro.site ?? site.url).href;
// Anteprima per i link condivisi: quella generata da scripts/genera-og.mjs per questa
// pagina (public/og/<nome>.jpg), altrimenti l'immagine passata o og-card.jpg.
const nomeOg = path.replace(/^\/|\/$/g, "").replace(/\//g, "-") || "home";
const ogGenerata = `/og/${nomeOg}.jpg`;
const ogFile = existsSync(nodePath.join(process.cwd(), "public", ogGenerata)) ? ogGenerata : image;
const ogImage = new URL(ogFile, Astro.site ?? site.url).href;

// Breadcrumb (SEO) — costruito dal path
const _base = Astro.site ?? site.url;
const _labels: Record<string, string> = {
  studio: "Chi siamo", servizi: "Servizi", team: "Team", scuole: "Scuole",
  faq: "Domande frequenti", blog: "Blog", contatti: "Contatti", privacy: "Privacy",
  "note-legali": "Note legali",
};
const _segs = path.split("/").filter(Boolean);
const breadcrumb = [{ name: "Home", url: new URL("/", _base).href }];
let _acc = "";
_segs.forEach((s, i) => {
  _acc += "/" + s;
  const name = _labels[s] ?? (i === _segs.length - 1 ? title : s);
  breadcrumb.push({ name, url: new URL(_acc + "/", _base).href });
});
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#f8f6f0" />
<meta name="generator" content={Astro.generator} />
<!-- GitHub Pages non permette header HTTP personalizzati: la Referrer-Policy va qui -->
<meta name="referrer" content="strict-origin-when-cross-origin" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{(noindex || !site.indicizza) && <meta name="robots" content="noindex, nofollow" />}

<!-- Senza JavaScript il menu mobile resta aperto sotto l'header (niente hamburger) -->
<noscript><style>@media (max-width:767px){#nav-toggle{display:none!important}#nav-menu{display:flex!important;position:static!important;flex-direction:row!important;flex-wrap:wrap;gap:.25rem 1rem;border:0!important;padding:.25rem 0 .75rem!important;background:transparent!important}header nav{height:auto!important;flex-wrap:wrap}}</style></noscript>

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:locale" content={site.locale} />
<meta property="og:site_name" content={site.nome} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />

<!-- Twitter/X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<!-- Favicon (logo Psiche Holos) -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!-- Font self-hosted (vedi @font-face in global.css) -->
<link rel="preload" href="/fonts/nunito-sans.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/playfair-display.woff2" as="font" type="font/woff2" crossorigin />

<!-- JSON-LD: studio (MedicalBusiness) + professioniste (Person) — vedi StudioSchema.astro -->
<StudioSchema />

{breadcrumb.length > 1 && (
  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: breadcrumb.map((b, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: b.name,
        item: b.url,
      })),
    })}
  />
)}
