---
// Footer compatto: una fascia sola. Logo, indirizzo e pagine a sinistra/centro,
// contatti a destra; sotto la riga con note legali e privacy.
import { site, navFooter, team } from "@/config/site";
import Icona from "@/components/Icona.astro";
const year = new Date().getFullYear();
const tenue = "text-[color-mix(in_srgb,var(--color-cream)_70%,transparent)]";
---

<footer class="mt-24 bg-[var(--color-ink)] text-[var(--color-cream)]">
  <div class="container-ph grid gap-8 py-10 md:grid-cols-[auto_1fr_auto] md:items-start md:gap-10">
    <div class="flex items-center gap-4 md:block">
      <img src="/loghi/logo-psiche-holos-cream.png" alt={`${site.nome} — logo`} width="104" height="95" class="h-16 w-auto md:h-20" />
      <p class={`text-sm md:hidden ${tenue}`}>
        Studio di Psicologia e Psicoterapia<br />Via Guido Zadei 60, Brescia
      </p>
    </div>

    <div>
      <p class={`hidden text-sm md:block ${tenue}`}>
        Studio di Psicologia e Psicoterapia · Via Guido Zadei 60, Brescia
      </p>
      <nav aria-label="Pagine del sito" class="md:mt-3">
        <ul class="flex flex-wrap gap-x-5 gap-y-1 text-sm font-semibold">
          {navFooter.map((item) => (
            <li><a href={item.href} class="link-underline inline-block py-1">{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="text-sm">
      <a href={`mailto:${site.email}`} class="link-underline inline-block py-1">{site.email}</a>
      <ul class="mt-1">
        {team.map((m) => (
          <li>
            <span class={tenue}>{m.nome} · </span>
            <a href={`tel:+39${m.telefonoDisplay.replace(/\s/g, "")}`} class="link-underline inline-block py-1">{m.telefonoDisplay}</a>
          </li>
        ))}
      </ul>
      <a
        href={site.instagram}
        target="_blank"
        rel="noopener"
        aria-label="Instagram di Psiche Holos"
        class="mt-3 grid h-9 w-9 place-items-center rounded-full border border-[color-mix(in_srgb,var(--color-cream)_35%,transparent)] transition-colors hover:border-[var(--color-cream)] hover:bg-[color-mix(in_srgb,var(--color-cream)_10%,transparent)]"
      >
        <Icona nome="instagram" size={18} />
      </a>
    </div>
  </div>

  <div class="border-t border-[color-mix(in_srgb,var(--color-cream)_15%,transparent)]">
    <!-- pb-24 su telefono: lascia spazio al pulsante "Prenota" flottante -->
    <div class="container-ph flex flex-col gap-1 pb-24 pt-4 text-xs text-[color-mix(in_srgb,var(--color-cream)_60%,transparent)] md:flex-row md:items-center md:justify-between md:pb-4">
      <span>
        © {year} Psiche Holos ·
        <a href="/note-legali/" class="link-underline inline-block py-1">Note legali</a> ·
        <a href="/privacy/" class="link-underline inline-block py-1">Privacy e cookie</a>
        {site.ga4Id && (
          <>
            ·
            <button type="button" data-preferenze-cookie hidden class="link-underline inline-block py-1">Preferenze cookie</button>
          </>
        )}
      </span>
      <span>Iscritte all'Ordine degli Psicologi della Lombardia</span>
    </div>
  </div>
</footer>
