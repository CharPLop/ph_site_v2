---
import { site, sedi, navFooter, team } from "@/config/site";
import Icona from "@/components/Icona.astro";
const year = new Date().getFullYear();
---

<footer class="mt-24 bg-[var(--color-ink)] text-[var(--color-cream)]">
  <div class="container-ph grid gap-10 py-16 md:grid-cols-3">
    <div>
      <img src="/loghi/logo-psiche-holos-cream.png" alt={`${site.nome} — logo`} width="104" height="95" class="h-24 w-auto" />
      <p class="mt-4 text-sm text-[color-mix(in_srgb,var(--color-cream)_70%,transparent)]">
        Studio di Psicologia e Psicoterapia · Brescia
      </p>
      <p class="mt-5 text-sm">
        <a href={`mailto:${site.email}`} class="link-underline inline-block py-1">{site.email}</a>
      </p>
      <ul class="mt-2 space-y-0.5 text-sm">
        {team.map((m) => (
          <li>
            <span class="opacity-70">{m.nome} · </span>
            <a href={`tel:+39${m.telefonoDisplay.replace(/\s/g, "")}`} class="link-underline inline-block py-1">{m.telefonoDisplay}</a>
          </li>
        ))}
      </ul>
      <div class="mt-5 flex gap-3 text-sm">
        <a
          href={site.instagram}
          target="_blank"
          rel="noopener"
          aria-label="Instagram di Psiche Holos"
          class="grid h-10 w-10 place-items-center rounded-full border border-[color-mix(in_srgb,var(--color-cream)_35%,transparent)] transition-colors hover:border-[var(--color-cream)] hover:bg-[color-mix(in_srgb,var(--color-cream)_10%,transparent)]"
        >
          <Icona nome="instagram" size={20} />
        </a>
      </div>
    </div>

    <div>
      <p class="kicker !text-[var(--color-sage)]">Pagine</p>
      <ul class="mt-4 space-y-2 text-sm">
        {navFooter.map((item) => (
          <li><a href={item.href} class="link-underline">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <p class="kicker !text-[var(--color-sage)]">Sedi</p>
      <ul class="mt-4 space-y-3 text-sm">
        {sedi.map((s) => (
          <li>
            <span class="font-semibold">{s.citta}</span><br />
            <span class="text-[color-mix(in_srgb,var(--color-cream)_70%,transparent)]">{s.indirizzo}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-[color-mix(in_srgb,var(--color-cream)_15%,transparent)]">
    <div class="container-ph flex flex-col gap-2 pb-24 pt-5 text-xs text-[color-mix(in_srgb,var(--color-cream)_60%,transparent)] md:flex-row md:items-center md:justify-between">
      <span>
        © {year} Psiche Holos ·
        <a href="/note-legali/" class="link-underline inline-block py-1">Note legali</a> ·
        <a href="/privacy/" class="link-underline inline-block py-1">Privacy e cookie</a>
        {site.ga4Id && (
          <>
            ·
            <button type="button" data-preferenze-cookie hidden class="link-underline inline-block py-1">Preferenze cookie</button>
          </>
        )}
      </span>
      <span>Via Guido Zadei, 60 · Brescia</span>
    </div>
  </div>
</footer>
