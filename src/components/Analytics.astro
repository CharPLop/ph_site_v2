---
// Analytics + consenso cookie — Psiche Holos
// INERTE finché site.ga4Id è vuoto: non carica nulla e non mostra alcun banner.
// Quando incolli l'ID GA4 in site.ts, si attivano insieme:
//  • banner cookie (Accetta / Rifiuta, stesso peso visivo) e link "Preferenze cookie" nel footer;
//  • GA4 caricato SOLO dopo "Accetta" (prima nessuna richiesta a Google);
//  • tracciamento eventi: WhatsApp, email, telefono, invio form, download brochure.
// La scelta viene salvata con la data (localStorage "ph-consenso") e riproposta dopo 6 mesi
// (Linee guida cookie del Garante, 10/6/2021). "Preferenze cookie" la revoca: cancella
// i cookie _ga*, dimentica la scelta e ripropone il banner.
import { site } from "@/config/site";
const GA4 = site.ga4Id;
---

{GA4 && (
  <>
    <div
      id="ph-cookie"
      hidden
      role="dialog"
      aria-live="polite"
      aria-label="Preferenze cookie"
      class="fixed inset-x-0 bottom-0 z-[60] border-t border-[var(--color-line)] bg-[var(--color-white-warm)] p-4"
    >
      <div class="container-ph flex flex-col items-start gap-3 md:flex-row md:items-center md:justify-between">
        <p class="text-sm text-[var(--color-ink-soft)]">
          Con il tuo consenso usiamo cookie analitici (Google Analytics) per capire come viene usato il sito.
          Il sito funziona allo stesso modo anche se li rifiuti.
          <a href="/privacy/" class="link-underline text-[var(--color-verde-dark)]">Maggiori informazioni</a>.
        </p>
        <div class="flex shrink-0 gap-2">
          <button id="ph-cookie-no" type="button" class="btn btn-ghost !py-2 !px-4 text-sm">Rifiuta</button>
          <button id="ph-cookie-ok" type="button" class="btn btn-ghost !py-2 !px-4 text-sm">Accetta</button>
        </div>
      </div>
    </div>

    <script define:vars={{ GA4 }}>
      (function () {
        var KEY = "ph-consenso";
        var VERSIONE = 1; // aumentala se cambiano i cookie usati: il banner verrà riproposto a tutti
        var DURATA = 1000 * 60 * 60 * 24 * 182; // circa 6 mesi

        function leggi() {
          try {
            var c = JSON.parse(localStorage.getItem(KEY) || "null");
            if (!c || c.v !== VERSIONE || Date.now() - c.data > DURATA) return null;
            return c.stato;
          } catch (e) { return null; }
        }
        function salva(stato) {
          try { localStorage.setItem(KEY, JSON.stringify({ stato: stato, data: Date.now(), v: VERSIONE })); } catch (e) {}
        }
        function cancellaCookieGA() {
          var dominio = location.hostname.split(".").slice(-2).join(".");
          document.cookie.split(";").forEach(function (c) {
            var nome = c.split("=")[0].trim();
            if (nome.indexOf("_ga") === 0) {
              [location.hostname, "." + location.hostname, "." + dominio].forEach(function (d) {
                document.cookie = nome + "=; Max-Age=0; path=/; domain=" + d;
              });
              document.cookie = nome + "=; Max-Age=0; path=/";
            }
          });
        }
        function loadGA() {
          if (window.__phGA) return;
          window.__phGA = true;
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag("consent", "default", {
            ad_storage: "denied", ad_user_data: "denied", ad_personalization: "denied",
            analytics_storage: "granted",
          });
          window.gtag("js", new Date());
          window.gtag("config", GA4);
          var s = document.createElement("script");
          s.async = true;
          s.src = "https://www.googletagmanager.com/gtag/js?id=" + GA4;
          document.head.appendChild(s);
        }
        function track(name, params) { if (window.__phGA && window.gtag) window.gtag("event", name, params || {}); }

        var banner = document.getElementById("ph-cookie");
        function mostra() { if (banner) banner.hidden = false; }
        function nascondi() { if (banner) banner.hidden = true; }

        var stato = leggi();
        if (stato === "granted") loadGA();
        else if (stato !== "denied") mostra();

        var ok = document.getElementById("ph-cookie-ok");
        var no = document.getElementById("ph-cookie-no");
        if (ok) ok.addEventListener("click", function () { salva("granted"); nascondi(); loadGA(); });
        if (no) no.addEventListener("click", function () { salva("denied"); nascondi(); cancellaCookieGA(); });

        // "Preferenze cookie" nel footer: revoca e ripropone la scelta
        document.querySelectorAll("[data-preferenze-cookie]").forEach(function (b) {
          b.hidden = false;
          b.addEventListener("click", function () {
            try { localStorage.removeItem(KEY); } catch (e) {}
            cancellaCookieGA();
            if (window.__phGA) { location.reload(); return; } // GA già caricato: si riparte puliti
            mostra();
            if (no) no.focus();
          });
        });

        // Tracciamento micro-conversioni (attivo solo se GA4 è stato caricato)
        function bind(sel, name) {
          document.querySelectorAll(sel).forEach(function (el) {
            el.addEventListener("click", function () { track(name, { link: el.getAttribute("href") }); });
          });
        }
        bind('a[href^="https://wa.me/"]', "contact_whatsapp");
        bind('a[href^="mailto:"]', "contact_email");
        bind('a[href^="tel:"]', "contact_phone");
        bind('a[href$=".pdf"][download]', "download_brochure");
        var f = document.getElementById("contactForm");
        if (f) f.addEventListener("submit", function () { track("contact_form_submit"); });
      })();
    </script>
  </>
)}
