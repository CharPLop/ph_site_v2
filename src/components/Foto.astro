---
// Foto da public/ con la versione WebP accanto, se esiste (generata da
// scripts/genera-derivate.mjs): il browser scarica la WebP, i più vecchi il JPG.
import { existsSync } from "node:fs";
import path from "node:path";

interface Props {
  src: string;
  alt: string;
  class?: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  width?: number | string;
  height?: number | string;
}
const { src, alt, class: classe, loading = "lazy", fetchpriority, width, height } = Astro.props;
const webp = src.replace(/\.jpe?g$/i, ".webp");
const haWebp = webp !== src && existsSync(path.join(process.cwd(), "public", webp));
---

<picture>
  {haWebp && <source srcset={webp} type="image/webp" />}
  <img src={src} alt={alt} class={classe} loading={loading} fetchpriority={fetchpriority} width={width} height={height} />
</picture>
